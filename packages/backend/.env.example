# Environment Variables for Backend

# Server Configuration
PORT=3030

# Kroger API Credentials
# Get these from https://developer.kroger.com/
# KROGER_CLIENT_ID=your_client_id_here
# KROGER_CLIENT_SECRET=your_client_secret_here

# Kroger Environment: 'cert' (Certification/Test) or 'prod' (Production)
# Use 'cert' for testing, 'prod' for live data (requires production credentials)
# KROGER_ENVIRONMENT=cert

# Default store location (Location ID from Kroger API)
# KROGER_LOCATION_ID=01400943

# Instacart API Credentials (Partner-only)
# INSTACART_API_KEY=your_api_key_here
# INSTACART_PARTNER_ID=your_partner_id_here

# Database (currently using in-memory SQLite)
# DB_PATH=:memory:
